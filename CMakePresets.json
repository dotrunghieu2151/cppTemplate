{
  "version": 8,
  "configurePresets": [
    {
      "name": "vcpkg",
      "displayName": "Configure vcpkg",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_FIND_DEBUG_MODE": false,
        "VCPKG_DISABLE_METRICS": false
      }
    }
  ],
  "buildPresets": [
    {
      "name": "release",
      "configurePreset": "vcpkg",
      "configuration": "Release"
    },
    {
      "name": "debug",
      "configurePreset": "vcpkg",
      "configuration": "Debug"
    }
  ]
}
